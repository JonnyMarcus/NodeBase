<!DOCTYPE html>
<html lang="pt-BR">
   <%- include("./partials/head.ejs") %> 
 <body>
  <header><h1>Usuários</h1></header>
  <div class="content">
    <% if (users.length > 0) { %>
      <% users.forEach(user => { %>
        <h3 class="title"><%= user.firstname %> <%= user.lastname %></h3>
        <p><%= user.email %></p>
      <% }) %>
    <% } else { %>
      <p>Nenhum usuário cadastrado.</p>
    <% } %>
  </div>
</body>
</html>