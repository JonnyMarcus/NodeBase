<!DOCTYPE html>
<html lang="pt-BR">
  <%- include("./partials/head.ejs") %>
  <body>
    <%- include("./partials/navbar.ejs") %>

    <section class="hero">
      <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <h1 class="fw-bold mb-1">Usuários</h1>
          <p class="mb-0 opacity-75">
            <i class="bi bi-people-fill me-1"></i><%= users.length %> cadastrado(s)
          </p>
        </div>
        <button class="btn btn-light fw-semibold shadow-sm" id="btnNovo">
          <i class="bi bi-plus-lg me-1"></i>Novo usuário
        </button>
      </div>
    </section>

    <main class="container conteudo pb-5">
      <% if (users.length > 0) { %>
        <div class="row g-4">
          <% users.forEach(user => { %>
            <div class="col-12 col-md-6 col-lg-4">
              <div class="card user-card shadow h-100">
                <div class="card-body">
                  <div class="d-flex align-items-center gap-3">
                    <div class="avatar">
                      <%= (user.firstname || "?").charAt(0).toUpperCase() %>
                    </div>
                    <div class="overflow-hidden">
                      <h5 class="card-title mb-1 text-truncate">
                        <%= user.firstname %> <%= user.lastname %>
                      </h5>
                      <p class="card-text text-muted small mb-0 text-truncate">
                        <i class="bi bi-envelope me-1"></i><%= user.email %>
                      </p>
                    </div>
                  </div>
                </div>
                <div class="card-footer bg-white border-0 d-flex gap-2 pb-3">
                  <button
                    class="btn btn-sm btn-outline-primary flex-fill btn-editar"
                    data-id="<%= user._id %>"
                    data-firstname="<%= user.firstname %>"
                    data-lastname="<%= user.lastname %>"
                    data-email="<%= user.email %>"
                  >
                    <i class="bi bi-pencil me-1"></i>Editar
                  </button>
                  <button
                    class="btn btn-sm btn-outline-danger flex-fill btn-excluir"
                    data-id="<%= user._id %>"
                    data-nome="<%= user.firstname %> <%= user.lastname %>"
                  >
                    <i class="bi bi-trash me-1"></i>Excluir
                  </button>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="card vazio shadow text-center p-5">
          <i class="bi bi-person-x display-3 text-muted"></i>
          <h4 class="mt-3">Nenhum usuário cadastrado</h4>
          <p class="text-muted mb-0">Clique em "Novo usuário" para criar o primeiro.</p>
        </div>
      <% } %>
    </main>

   
    <div class="modal fade" id="userModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="userForm">
          <div class="modal-header">
            <h5 class="modal-title" id="modalTitulo">Novo usuário</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" id="userId" />
            <div class="mb-3">
              <label class="form-label" for="firstname">Nome</label>
              <input class="form-control" id="firstname" required />
            </div>
            <div class="mb-3">
              <label class="form-label" for="lastname">Sobrenome</label>
              <input class="form-control" id="lastname" required />
            </div>
            <div class="mb-3">
              <label class="form-label" for="email">Email</label>
              <input type="email" class="form-control" id="email" required />
            </div>
            <div class="mb-3">
              <label class="form-label" for="password">Senha</label>
              <input type="password" class="form-control" id="password" minlength="7" />
              <div class="form-text" id="dicaSenha">Mínimo de 7 caracteres.</div>
            </div>
            <div class="alert alert-danger d-none" id="erro"></div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-success">Salvar</button>
          </div>
        </form>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      const modal = new bootstrap.Modal(document.getElementById("userModal"));
      const form = document.getElementById("userForm");
      const erro = document.getElementById("erro");


      const campo = (id) => document.getElementById(id);

      function abrirModal(user) {
        form.reset();
        erro.classList.add("d-none");

        if (user) {
       
          campo("modalTitulo").textContent = "Editar usuário";
          campo("userId").value = user.id;
          campo("firstname").value = user.firstname;
          campo("lastname").value = user.lastname;
          campo("email").value = user.email;
          campo("password").required = false;
          campo("dicaSenha").textContent = "Deixe em branco para manter a senha atual.";
        } else {
  
          campo("modalTitulo").textContent = "Novo usuário";
          campo("userId").value = "";
          campo("password").required = true;
          campo("dicaSenha").textContent = "Mínimo de 7 caracteres.";
        }
        modal.show();
      }

     
      campo("btnNovo").addEventListener("click", () => abrirModal(null));

     
      document.querySelectorAll(".btn-editar").forEach((btn) => {
        btn.addEventListener("click", () => abrirModal(btn.dataset));
      });

    
      document.querySelectorAll(".btn-excluir").forEach((btn) => {
        btn.addEventListener("click", async () => {
          if (!confirm(`Excluir ${btn.dataset.nome}?`)) return;

          const resp = await fetch(`/users/${btn.dataset.id}`, { method: "DELETE" });
          if (resp.ok) location.reload();
          else alert("Erro ao excluir usuário.");
        });
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const id = campo("userId").value;
        const dados = {
          firstname: campo("firstname").value,
          lastname: campo("lastname").value,
          email: campo("email").value,
        };
        
        if (campo("password").value) dados.password = campo("password").value;

        const resp = await fetch(id ? `/users/${id}` : "/users", {
          method: id ? "PATCH" : "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(dados),
        });

        if (resp.ok) {
          location.reload();
        } else {
          const data = await resp.json();
          erro.textContent = data.error || "Erro ao salvar.";
          erro.classList.remove("d-none");
        }
      });
    </script>
  </body>
</html>